{
  "all": true,
  "include": [
    "nodes/**/*.js",
    "index.js"
  ],
  "exclude": [
    "test/**",
    "coverage/**",
    "node_modules/**",
    "examples/**",
    "**/*.test.js",
    "**/*.spec.js"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "coverage",
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 75,
  "cache": true,
  "temp-dir": ".nyc_output"
}