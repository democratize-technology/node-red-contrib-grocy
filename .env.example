# Grocy server URL (no trailing slash)
GROCY_URL=http://your-grocy-server:9283

# Grocy API key — found in Grocy → Manage API keys
GROCY_API_KEY=your-api-key-here

# SSL options (for self-hosted instances with self-signed certs)
GROCY_VERIFY_SSL=true
GROCY_ALLOW_SELF_SIGNED=false

# Request timeout in milliseconds
GROCY_TIMEOUT=30000
